# FastAPI application
SMARTCOMMERCE_AI_APP_NAME="SmartCommerce AI Service"
SMARTCOMMERCE_AI_APP_VERSION=0.1.0
SMARTCOMMERCE_AI_ENVIRONMENT=local

# Export these values before starting Uvicorn, or pass --host and --port.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8002

# PostgreSQL 17 + pgvector (Docker publishes container port 5432 on 5433)
SMARTCOMMERCE_AI_POSTGRES_HOST=127.0.0.1
SMARTCOMMERCE_AI_POSTGRES_PORT=5433
SMARTCOMMERCE_AI_POSTGRES_DB=smartcommerce_ai
SMARTCOMMERCE_AI_POSTGRES_USER=smartcommerce_ai
SMARTCOMMERCE_AI_POSTGRES_PASSWORD=

# LLM generation: Ollama Cloud is the primary provider.
SMARTCOMMERCE_AI_LLM_PROVIDER=ollama_cloud
SMARTCOMMERCE_AI_ALLOW_PROVIDER_FALLBACK=false
# Leave unset while fallback is disabled. Example explicit value: ollama_local
# SMARTCOMMERCE_AI_LLM_FALLBACK_PROVIDER=ollama_local

SMARTCOMMERCE_AI_OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434
SMARTCOMMERCE_AI_OLLAMA_CLOUD_BASE_URL=https://ollama.com
SMARTCOMMERCE_AI_OLLAMA_LOCAL_MODEL=llama3.2:1b
SMARTCOMMERCE_AI_OLLAMA_CLOUD_MODEL=gpt-oss:20b
SMARTCOMMERCE_AI_OLLAMA_API_KEY=
SMARTCOMMERCE_AI_OLLAMA_CONNECT_TIMEOUT_SECONDS=3
SMARTCOMMERCE_AI_OLLAMA_READ_TIMEOUT_SECONDS=120
SMARTCOMMERCE_AI_OLLAMA_TEMPERATURE=0.2
SMARTCOMMERCE_AI_OLLAMA_NUM_PREDICT=1200
SMARTCOMMERCE_AI_OLLAMA_NUM_CTX=4096

# Local semantic embeddings
SMARTCOMMERCE_AI_EMBEDDING_PROVIDER=ollama_local
SMARTCOMMERCE_AI_EMBEDDING_MODEL=embeddinggemma
SMARTCOMMERCE_AI_EMBEDDING_DIMENSIONS=768
SMARTCOMMERCE_AI_EMBEDDING_BATCH_SIZE=16
SMARTCOMMERCE_AI_EMBEDDING_CONNECT_TIMEOUT_SECONDS=3
SMARTCOMMERCE_AI_EMBEDDING_READ_TIMEOUT_SECONDS=120

# Semantic RAG retrieval and PDF ingestion
SMARTCOMMERCE_AI_RAG_CHUNK_SIZE_CHARS=1200
SMARTCOMMERCE_AI_RAG_CHUNK_OVERLAP_CHARS=200
SMARTCOMMERCE_AI_RAG_MIN_CHUNK_SIZE_CHARS=80
SMARTCOMMERCE_AI_RAG_TOP_K=5
SMARTCOMMERCE_AI_RAG_MIN_SCORE=0.40
SMARTCOMMERCE_AI_RAG_MAX_UPLOAD_BYTES=20971520
SMARTCOMMERCE_AI_RAG_MAX_PDF_PAGES=200
SMARTCOMMERCE_AI_RAG_MIN_EXTRACTED_CHARS=50
